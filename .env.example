# Atlas auth — copy this file to .env and fill in your instance's values.
#
# Public (safe in the browser). SvelteKit exposes PUBLIC_-prefixed vars to the
# client via $env/dynamic/public.
PUBLIC_ATLAS_PUBLISHABLE_KEY=pk_test_xxx
PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# Server-only JWT verification (read by src/hooks.server.ts via handleAtlas).
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net
